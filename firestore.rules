rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      // Check if the user signed in anonymously
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      // Admins are authenticated non-anonymous users (e.g., Email/Password)
      return isAuthenticated() && !isAnonymous();
    }

    // Lock down all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow access to the specific app path
    match /artifacts/{appId}/public/data {

      // Panic Button (S.O.S) - accessible by all residents
      match /panic/status {
        allow read, write: if isAuthenticated();
      }

      // Configuration (App Logo, CCTV Link) - Read by all, Write by Admin
      match /config/{configId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Information/Announcements - Read by all, Write by Admin
      match /informasi/{infoId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Registrations - Create by all, Read by Admin or Owner
      match /registrations/{regId} {
        allow create: if isAuthenticated();
        allow read: if isAdmin() || (isAuthenticated() && resource.data.registeredBy == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      // Service Requests - Create by all, Read by Admin or Owner
      match /service_requests/{reqId} {
        allow create: if isAuthenticated();
        allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      // Forum - Read/Create by all, Update/Delete by Admin or Author
      match /forum/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }
  }
}
